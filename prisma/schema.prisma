// ---------------------------------------------------------------------------

enum ProductCategory {
  PIZZA_SALGADA
  PIZZA_DOCE
  COMBO
  ESFIHA_SALGADA
  ESFIHA_DOCE
  ACOMPANHAMENTO
  BURGER
  BEBIDA
  DRINK
  SOBREMESA
}

model Ingredient {
  id                     String         @id @default(cuid())
  empresaId              String
  empresa                Empresa        @relation(fields: [empresaId], references: [id])
  name                   String
  fornecedor             String?
  unidade                String         @default("g")
  precoAtual             Float          @default(0)
  quantidadeEmbalagem    Float          @default(1)
  percentualPerda        Float          @default(0)
  estoqueMinimo          Float          @default(0)
  estoqueAtual           Float          @default(0)
  validade               DateTime?
  lastPurchaseDate       DateTime?
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  // --- Cadastro de produto/insumo (módulo Estoque) ---
  categoryId             String?
  category               StockCategory? @relation(fields: [categoryId], references: [id])
  setor                  String?
  codigoInterno          String?
  codigoBarras           String?
  localArmazenamento     String?
  unidadeCompra          String?
  fatorConversao         Float          @default(1)
  pesoEmbalagem          Float?
  rendimentoAproveitavel Float?
  estoqueMaximo          Float?
  pontoReposicao         Float?
  fornecedorPrincipalId  String?
  fornecedorPrincipal    Supplier?      @relation(fields: [fornecedorPrincipalId], references: [id])
  perecivel              Boolean        @default(false)
  active                 Boolean        @default(true)
  fotoUrl                String?

  priceHistory  IngredientPriceHistory[]
  productLinks  ProductIngredient[]
  movements     StockMovement[]
  purchaseItems PurchaseItem[]
  losses        Loss[]
  transferItems TransferItem[]
  countItems    StockCountItem[]
}

model IngredientPriceHistory {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  price        Float
  createdAt    DateTime   @default(now())
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  PERDA
  TRANSFERENCIA
  INVENTARIO
}

model StockMovement {
  id            String            @id @default(cuid())
  ingredientId  String
  ingredient    Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  empresaId     String
  empresa       Empresa           @relation(fields: [empresaId], references: [id])
  type          StockMovementType
  quantidade    Float
  estoqueApos   Float
  motivo        String?
  /// Origem funcional do lançamento, para relatórios de CMV Real e auditoria: COMPRA, MANUAL, VENDA, PERDA, CORTESIA, CONSUMO_INTERNO, TRANSFERENCIA_ENVIADA, TRANSFERENCIA_RECEBIDA, DEVOLUCAO_FORNECEDOR, CANCELAMENTO, CONTAGEM, AJUSTE_POSITIVO, AJUSTE_NEGATIVO.
  origin        String?
  origem        String?
  destino       String?
  documentoUrl  String?
  autorizadoPor String?
  createdById   String
  createdBy     User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime          @default(now())

  @@index([ingredientId])
  @@index([empresaId, createdAt])
}

model Product {
  id           String          @id @default(cuid())
  empresaId    String
  empresa      Empresa         @relation(fields: [empresaId], references: [id])
  name         String
  code         String          @unique
  category     ProductCategory
  photoUrl     String?
  description  String?
  rendimento   String?
  tamanho      String?
  pesoFinal    Float?
  precoVenda   Float           @default(0)
  taxaIfood    Float?
  modoPreparo  String?
  tempoPreparo Int?
  validade     String?
  responsavel  String?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  ingredients ProductIngredient[]
  saleItems   SaleItem[]
}

model ProductIngredient {
  id              String     @id @default(cuid())
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  order           Int        @default(0)
  quantidadeUsada Float
  percentualPerda Float      @default(0)
}

model CategoryQualityConfig {
  id                String          @id @default(cuid())
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  category          ProductCategory
  cmvMaximoPercent  Float           @default(35)
  diasDesatualizada Int             @default(90)
  updatedAt         DateTime        @updatedAt

  @@unique([empresaId, category])
}

// ---------------------------------------------------------------------------
// ESTOQUE — módulo completo (compras, fornecedores, recebimento,
// transferências, perdas, contagens, planos de ação)
// ---------------------------------------------------------------------------

model StockCategory {
  id                    String   @id @default(cuid())
  key                   String   @unique
  name                  String
  color                 String   @default("#2952E3")
  icon                  String   @default("Boxes")
  setor                 String?
  order                 Int      @default(0)
  metaPerdaPercent      Float    @default(2)
  periodicidadeContagem String   @default("SEMANAL")
  active                Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  ingredients Ingredient[]
}

model Supplier {
  id                 String   @id @default(cuid())
  empresaId          String
  empresa            Empresa  @relation(fields: [empresaId], references: [id])
  razaoSocial        String
  nomeFantasia       String?
  cnpj               String?
  telefone           String?
  whatsapp           String?
  email              String?
  endereco           String?
  prazoPagamentoDias Int?
  prazoEntregaDias   Int?
  pedidoMinimo       Float?
  avaliacao          Float    @default(0)
  active             Boolean  @default(true)
  observacao         String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  ingredients Ingredient[]
  purchases   Purchase[]
}

enum PurchaseStatus {
  PEDIDO_REALIZADO
  AGUARDANDO_ENTREGA
  RECEBIDO_PARCIAL
  RECEBIDO
  DIVERGENCIA
  CANCELADO
}

model Purchase {
  id                   String         @id @default(cuid())
  empresaId            String
  empresa              Empresa        @relation(fields: [empresaId], references: [id])
  supplierId           String
  supplier             Supplier       @relation(fields: [supplierId], references: [id])
  numeroNota           String?
  data                 DateTime       @default(now())
  compradorResponsavel String?
  formaPagamento       PaymentMethod?
  dataVencimento       DateTime?
  notaFiscalUrl        String?
  desconto             Float          @default(0)
  frete                Float          @default(0)
  status               PurchaseStatus @default(PEDIDO_REALIZADO)
  observacoes          String?
  createdById          String
  createdBy            User           @relation("PurchaseCreatedBy", fields: [createdById], references: [id])
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  items     PurchaseItem[]
  receiving Receiving?

  @@index([empresaId, data])
}

model PurchaseItem {
  id            String     @id @default(cuid())
  purchaseId    String
  purchase      Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  quantidade    Float
  unidade       String
  valorUnitario Float
  valorTotal    Float

  @@index([purchaseId])
}

enum ReceivingStatus {
  APROVADO
  APROVADO_RESSALVA
  RECEBIDO_PARCIAL
  RECUSADO
  AGUARDANDO_SOLUCAO
}

model Receiving {
  id                String          @id @default(cuid())
  purchaseId        String          @unique
  purchase          Purchase        @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  dataHora          DateTime        @default(now())
  responsavel       String?
  status            ReceivingStatus @default(AGUARDANDO_SOLUCAO)
  /// Divergências marcadas: FALTA, EXCESSO, PESO_INCORRETO, PRODUTO_DANIFICADO, FORA_TEMPERATURA, VALIDADE_CURTA, PRODUTO_DIFERENTE, PRECO_DIFERENTE — lista separada por vírgula.
  divergencias      String?
  detalhes          String?
  fotoMercadoriaUrl String?
  fotoNotaUrl       String?
  observacao        String?
  createdAt         DateTime        @default(now())
}

enum TransferStatus {
  SOLICITADA
  SEPARACAO
  ENVIADA
  RECEBIDA
  DIVERGENCIA
}

model Transfer {
  id                     String         @id @default(cuid())
  origemEmpresaId        String
  origemEmpresa          Empresa        @relation("TransferOrigem", fields: [origemEmpresaId], references: [id])
  destinoEmpresaId       String
  destinoEmpresa         Empresa        @relation("TransferDestino", fields: [destinoEmpresaId], references: [id])
  status                 TransferStatus @default(SOLICITADA)
  responsavelEnvio       String?
  responsavelRecebimento String?
  dataEnvio              DateTime?
  dataRecebimento        DateTime?
  observacao             String?
  createdById            String
  createdBy              User           @relation("TransferCreatedBy", fields: [createdById], references: [id])
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  items TransferItem[]
}

model TransferItem {
  id                 String     @id @default(cuid())
  transferId         String
  transfer           Transfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredientId       String
  ingredient         Ingredient @relation(fields: [ingredientId], references: [id])
  unidade            String
  quantidadeEnviada  Float
  quantidadeRecebida Float?
  observacao         String?
}

enum LossReason {
  VENCIMENTO
  ERRO_PRODUCAO
  QUEIMA
  QUEDA
  CONTAMINACAO
  ARMAZENAMENTO_INCORRETO
  PORCIONAMENTO_INCORRETO
  DEVOLUCAO_CLIENTE
  SOBRA_PRODUCAO
  PERDA_LIMPEZA
  PRODUTO_DANIFICADO
  FURTO
  OUTRO
}

model Loss {
  id            String     @id @default(cuid())
  empresaId     String
  empresa       Empresa    @relation(fields: [empresaId], references: [id])
  setor         String?
  ingredientId  String
  ingredient    Ingredient @relation(fields: [ingredientId], references: [id])
  quantidade    Float
  unidade       String
  valorEstimado Float      @default(0)
  motivo        LossReason
  responsavel   String?
  aprovador     String?
  fotoUrl       String?
  observacao    String?
  data          DateTime   @default(now())
  createdById   String
  createdBy     User       @relation("LossCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime   @default(now())

  @@index([empresaId, data])
}

enum CountType {
  SEMANAL
  MENSAL
}

enum CountStatus {
  RASCUNHO
  EM_ANDAMENTO
  CONCLUIDA
  APROVADA
  REABERTA
}

model StockCount {
  id               String      @id @default(cuid())
  empresaId        String
  empresa          Empresa     @relation(fields: [empresaId], references: [id])
  type             CountType
  setor            String?
  semana           Int?
  mes              Int?
  ano              Int
  dataContagem     DateTime    @default(now())
  responsavel      String?
  horaInicio       String?
  horaFim          String?
  status           CountStatus @default(RASCUNHO)
  checklistJson    String?
  motivoReabertura String?
  aprovadoPor      String?
  aprovadoEm       DateTime?
  createdById      String
  createdBy        User        @relation("StockCountCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  items StockCountItem[]

  @@index([empresaId, type, ano])
}

enum CountItemStatus {
  PENDENTE
  CONTADO
  CONFERIDO
  DIVERGENCIA
  RECONTAGEM
  APROVADO
}

model StockCountItem {
  id                String          @id @default(cuid())
  countId           String
  count             StockCount      @relation(fields: [countId], references: [id], onDelete: Cascade)
  ingredientId      String
  ingredient        Ingredient      @relation(fields: [ingredientId], references: [id])
  setor             String?
  estoqueEsperado   Float           @default(0)
  quantidadeContada Float?
  diferencaQtd      Float?
  diferencaPercent  Float?
  diferencaReais    Float?
  status            CountItemStatus @default(PENDENTE)
  observacao        String?
  fotoUrl           String?
  justificativa     String?

  @@index([countId])
}

enum ActionPlanStatus {
  PENDENTE
  EM_ANDAMENTO
  CONCLUIDO
  ATRASADO
}

model ActionPlan {
  id            String           @id @default(cuid())
  empresaId     String
  empresa       Empresa          @relation(fields: [empresaId], references: [id])
  problema      String
  causaProvavel String?
  acaoCorretiva String
  responsavel   String?
  prazo         DateTime?
  status        ActionPlanStatus @default(PENDENTE)
  evidenciaUrl  String?
  createdById   String
  createdBy     User             @relation("ActionPlanCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// FINANCEIRO
// ---------------------------------------------------------------------------

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  VOUCHER
  TED
  DOC
  TRANSFERENCIA
  CHEQUE
  OUTRO
}

enum FinanceEntryStatus {
  EM_ABERTO
  PAGO
  PARCIALMENTE_PAGO
  CANCELADO
  ATRASADO
}

enum FinanceCategoryType {
  RECEITA
  DESPESA
  CUSTO
  INVESTIMENTO
}

enum CashMovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  APORTE_SOCIO
  RETIRADA_SOCIO
}

enum BankTransactionDirection {
  ENTRADA
  SAIDA
}

enum BankTransactionStatus {
  PENDENTE
  CONCILIADO
  IGNORADO
}

model BankAccount {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  name         String
  bank         String?
  agencia      String?
  conta        String?
  tipo         String   @default("Conta Corrente")
  saldoInicial Float    @default(0)
  saldoAtual   Float    @default(0)
  color        String   @default("#2952E3")
  icon         String   @default("Landmark")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payables               Payable[]
  receivables            Receivable[]
  cashMovements          CashMovement[]              @relation("CashMovementAccount")
  cashMovementsDestino   CashMovement[]              @relation("CashMovementDestino")
  recurringTemplates     RecurringTemplate[]
  bankTransactions       BankTransaction[]
  reconciliationImports  BankReconciliationImport[]
}

model FinancialCategory {
  id        String              @id @default(cuid())
  name      String              @unique
  type      FinanceCategoryType @default(DESPESA)
  dreKey    String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  payables           Payable[]
  receivables        Receivable[]
  recurringTemplates RecurringTemplate[]
}

model FinanceAttachment {
  id         String   @id @default(cuid())
  entityType String // PAYABLE | RECEIVABLE
  entityId   String
  fileName   String
  fileUrl    String
  createdAt  DateTime @default(now())
}

model RecurringTemplate {
  id                String            @id @default(cuid())
  tipo              String // PAGAR | RECEBER
  descricao         String
  fornecedorCliente String?
  categoriaId       String
  categoria         FinancialCategory @relation(fields: [categoriaId], references: [id])
  empresaId         String
  empresa           Empresa           @relation(fields: [empresaId], references: [id])
  centroCusto       String?
  valor             Float
  diaVencimento     Int
  bankAccountId     String
  bankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id])
  formaPagamento    PaymentMethod     @default(PIX)
  infinita          Boolean           @default(false)
  quantidadeMeses   Int?
  dataInicio        DateTime
  active            Boolean           @default(true)
  createdById       String
  createdBy         User              @relation(fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payables    Payable[]
  receivables Receivable[]
}

model Payable {
  id                  String             @id @default(cuid())
  sequence            Int                @default(autoincrement())
  number              String
  fornecedor          String
  descricao           String
  categoriaId         String
  categoria           FinancialCategory  @relation(fields: [categoriaId], references: [id])
  centroCusto         String?
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  valor               Float
  dataCompetencia     DateTime
  dataVencimento      DateTime
  dataPagamento       DateTime?
  bankAccountId       String?
  bankAccount         BankAccount?       @relation(fields: [bankAccountId], references: [id])
  formaPagamento      PaymentMethod?
  parcelado           Boolean            @default(false)
  quantidadeParcelas  Int?
  parcelaAtual        Int?
  observacoes         String?
  status              FinanceEntryStatus @default(EM_ABERTO)
  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([empresaId, status, dataVencimento])
  @@index([empresaId, dataCompetencia])
}

model Receivable {
  id                  String             @id @default(cuid())
  sequence            Int                @default(autoincrement())
  number              String
  cliente             String
  descricao           String
  categoriaId         String
  categoria           FinancialCategory  @relation(fields: [categoriaId], references: [id])
  centroCusto         String?
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  valor               Float
  dataCompetencia     DateTime
  dataVencimento      DateTime
  dataRecebimento     DateTime?
  bankAccountId       String?
  bankAccount         BankAccount?       @relation(fields: [bankAccountId], references: [id])
  formaRecebimento    PaymentMethod?
  parcelado           Boolean            @default(false)
  quantidadeParcelas  Int?
  parcelaAtual        Int?
  observacoes         String?
  status              FinanceEntryStatus @default(EM_ABERTO)
  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([empresaId, status, dataVencimento])
  @@index([empresaId, dataCompetencia])
}

model CashMovement {
  id            String           @id @default(cuid())
  type          CashMovementType
  bankAccountId String
  bankAccount   BankAccount      @relation("CashMovementAccount", fields: [bankAccountId], references: [id])
  destinoId     String?
  destino       BankAccount?     @relation("CashMovementDestino", fields: [destinoId], references: [id])
  valor         Float
  descricao     String?
  empresaId     String?
  empresa       Empresa?         @relation(fields: [empresaId], references: [id])
  date          DateTime         @default(now())
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
}

model BankReconciliationImport {
  id            String   @id @default(cuid())
  empresaId     String
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  bankAccountId String
  bankAccount   BankAccount @relation(fields: [bankAccountId], references: [id])
  fileName      String
  totalEntradas Float    @default(0)
  totalSaidas   Float    @default(0)
  totalLinhas   Int      @default(0)
  createdById   String
  createdBy     User     @relation(fields: [createdById], references: [id])
  createdAt     DateTime @default(now())

  transactions BankTransaction[]

  @@index([empresaId, bankAccountId])
}

model BankTransaction {
  id            String                    @id @default(cuid())
  empresaId     String
  empresa       Empresa                   @relation(fields: [empresaId], references: [id])
  bankAccountId String
  bankAccount   BankAccount               @relation(fields: [bankAccountId], references: [id])
  importId      String
  import        BankReconciliationImport  @relation(fields: [importId], references: [id], onDelete: Cascade)
  date          DateTime
  descricao     String
  direction     BankTransactionDirection
  valor         Float
  status        BankTransactionStatus     @default(PENDENTE)
  matchedType   String? // PAYABLE | RECEIVABLE
  matchedId     String?
  observacoes   String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([empresaId, bankAccountId, date])
  @@index([importId])
  @@index([matchedType, matchedId])
}

// ---------------------------------------------------------------------------
// UNIVERSIDADE GRUPO NORD — treinamentos, trilhas, videoaulas, avaliações,
// certificados, gamificação e biblioteca
// ---------------------------------------------------------------------------

enum CourseStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum ModuleType {
  VIDEO
  PDF
  CHECKLIST
  LINK
}

enum EnrollmentStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
  REPROVADO
}

enum QuestionType {
  MULTIPLA_ESCOLHA
  VERDADEIRO_FALSO
  DISSERTATIVA
}

model TrainingTrack {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  cargo       String?
  empresaId   String?
  empresa     Empresa? @relation(fields: [empresaId], references: [id])
  description String?
  icon        String   @default("GraduationCap")
  color       String   @default("#2952E3")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses TrainingTrackCourse[]
}

model TrainingCourse {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  category     String?
  description  String?
  cargo        String?
  empresaId    String?
  empresa      Empresa?     @relation(fields: [empresaId], references: [id])
  imageUrl     String?
  instructor   String?
  cargaHoraria Int          @default(0)
  status       CourseStatus @default(RASCUNHO)
  mandatory    Boolean      @default(false)
  version      Int          @default(1)
  order        Int          @default(0)
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  modules              TrainingModule[]
  tracks               TrainingTrackCourse[]
  enrollments          TrainingEnrollment[]
  quiz                 TrainingQuiz?
  trainingCertificates TrainingCertificate[]
}

model TrainingTrackCourse {
  id       String         @id @default(cuid())
  trackId  String
  track    TrainingTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  courseId String
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int            @default(0)

  @@unique([trackId, courseId])
}

model TrainingModule {
  id              String         @id @default(cuid())
  courseId        String
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  type            ModuleType     @default(VIDEO)
  videoUrl        String?
  durationSeconds Int            @default(0)
  pdfUrl          String?
  content         String?
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  progress TrainingModuleProgress[]
}

model TrainingEnrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  courseId        String
  course          TrainingCourse   @relation(fields: [courseId], references: [id])
  status          EnrollmentStatus @default(NAO_INICIADO)
  progressPercent Int              @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  moduleProgress TrainingModuleProgress[]
  attempts       TrainingAttempt[]
  certificate    TrainingCertificate?

  @@unique([userId, courseId])
}

model TrainingModuleProgress {
  id             String             @id @default(cuid())
  enrollmentId   String
  enrollment     TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId       String
  module         TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  watchedSeconds Int                @default(0)
  percentWatched Int                @default(0)
  completed      Boolean            @default(false)
  playCount      Int                @default(0)
  lastDevice     String?
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessAt   DateTime           @default(now())

  @@unique([enrollmentId, moduleId])
}

model TrainingQuiz {
  id               String         @id @default(cuid())
  courseId         String         @unique
  course           TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  minScore         Int            @default(70)
  maxAttempts      Int            @default(3)
  timeLimitMinutes Int?

  questions TrainingQuestion[]
  attempts  TrainingAttempt[]
}

model TrainingQuestion {
  id     String       @id @default(cuid())
  quizId String
  quiz   TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text   String
  type   QuestionType @default(MULTIPLA_ESCOLHA)
  order  Int          @default(0)

  options TrainingQuestionOption[]
}

model TrainingQuestionOption {
  id         String           @id @default(cuid())
  questionId String
  question   TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  correct    Boolean          @default(false)
  order      Int              @default(0)
}

model TrainingAttempt {
  id            String             @id @default(cuid())
  quizId        String
  quiz          TrainingQuiz       @relation(fields: [quizId], references: [id])
  enrollmentId  String
  enrollment    TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  score         Int                @default(0)
  passed        Boolean            @default(false)
  answers       String?
  attemptNumber Int                @default(1)
  startedAt     DateTime           @default(now())
  submittedAt   DateTime?
}

model TrainingCertificate {
  id           String             @id @default(cuid())
  code         String             @unique
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  courseId     String
  course       TrainingCourse     @relation(fields: [courseId], references: [id])
  enrollmentId String             @unique
  enrollment   TrainingEnrollment @relation(fields: [enrollmentId], references: [id])
  cargaHoraria Int                @default(0)
  issuedAt     DateTime           @default(now())
}

model TrainingBadge {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String   @default("Award")
  color       String   @default("#eab308")
  createdAt   DateTime @default(now())

  users TrainingUserBadge[]
}

model TrainingUserBadge {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id])
  badgeId  String
  badge    TrainingBadge @relation(fields: [badgeId], references: [id])
  earnedAt DateTime      @default(now())

  @@unique([userId, badgeId])
}

model TrainingXpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model TrainingLibraryItem {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("Documentos")
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  tags         String?
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  empresaId  String?
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  createdAt  DateTime @default(now())
}
