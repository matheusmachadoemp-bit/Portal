// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// AUTH / USERS / PERMISSIONS
// ---------------------------------------------------------------------------

enum Role {
  ADMINISTRADOR
  GESTOR
  GERENTE
  SUPERVISOR
  COLABORADOR
}

enum AccessLevel {
  NENHUM
  VISUALIZAR
  EDITAR
  TOTAL
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String
  role                Role               @default(COLABORADOR)
  active              Boolean            @default(true)
  avatarUrl           String?
  phone               String?
  resetToken          String?
  resetTokenExp       DateTime?
  lastLoginAt         DateTime?
  canViewGrupoNord    Boolean            @default(false)
  defaultEmpresaId    String?
  defaultEmpresa      Empresa?           @relation("UserDefaultEmpresa", fields: [defaultEmpresaId], references: [id])
  permissionProfileId String?
  permissionProfile   PermissionProfile? @relation(fields: [permissionProfileId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  permissions                   UserPermission[]
  empresaAccess                 UserEmpresaAccess[]
  menuPreferences               MenuPreference?
  auditLogs                     AuditLog[]
  salesEntries                  SalesEntry[]
  marketingEntries              MarketingEntry[]
  marketingTasksResponsavel     MarketingTask[]        @relation("MarketingTaskResponsavel")
  marketingTasksCreated         MarketingTask[]        @relation("MarketingTaskCreatedBy")
  marketingComments             MarketingComment[]
  marketingCampaignsResponsavel MarketingCampaign[]    @relation("MarketingCampaignResponsavel")
  marketingCampaignsCreated     MarketingCampaign[]    @relation("MarketingCampaignCreatedBy")
  marketingFiles                MarketingFile[]
  marketingIdeas                MarketingIdea[]
  goals                         Goal[]
  waiterSalesCreated            WaiterSaleEntry[]      @relation("WaiterSaleCreatedBy")
  stockMovementsCreated         StockMovement[]        @relation("StockMovementCreatedBy")
  purchasesCreated              Purchase[]             @relation("PurchaseCreatedBy")
  transfersCreated              Transfer[]             @relation("TransferCreatedBy")
  lossesCreated                 Loss[]                 @relation("LossCreatedBy")
  stockCountsCreated            StockCount[]           @relation("StockCountCreatedBy")
  actionPlansCreated            ActionPlan[]           @relation("ActionPlanCreatedBy")
  salesCreated                  Sale[]                 @relation("SaleCreatedBy")
  vaultEntries                  VaultEntry[]
  vaultAccess                   VaultAccessLog[]
  courses                       Course[]
  files                         FileItem[]
  products                      Product[]
  occurrences                   Occurrence[]           @relation("OccurrenceCreatedBy")
  rhFinanceEntries              EmployeeFinanceEntry[] @relation("RhFinanceCreatedBy")
  vacationsCreated              Vacation[]             @relation("VacationCreatedBy")
  uniformDeliveriesCreated      UniformDelivery[]      @relation("UniformCreatedBy")
  employeeDocumentsCreated      EmployeeDocument[]     @relation("EmployeeDocumentCreatedBy")
  payables                      Payable[]
  receivables                   Receivable[]
  cashMovements                 CashMovement[]
  recurringTemplates            RecurringTemplate[]
  bankReconciliationImports     BankReconciliationImport[]
  trainingCoursesCreated        TrainingCourse[]
  trainingEnrollments           TrainingEnrollment[]
  trainingAttempts              TrainingAttempt[]
  trainingCertificates          TrainingCertificate[]
  trainingBadges                TrainingUserBadge[]
  trainingXpEvents              TrainingXpEvent[]
  trainingLibraryItems          TrainingLibraryItem[]
  customerNotesAuthored         CustomerNote[]         @relation("CustomerNoteAuthor")
  crmSegmentsCreated            CrmSegment[]           @relation("CrmSegmentCreatedBy")
  campaignsCreated              Campaign[]             @relation("CampaignCreatedBy")
  automationsCreated            Automation[]           @relation("AutomationCreatedBy")
  npsResponsesAssigned          NpsResponse[]          @relation("NpsResponsavel")
}

model UserPermission {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleKey String
  level     AccessLevel @default(VISUALIZAR)
  createdAt DateTime    @default(now())

  @@unique([userId, moduleKey])
}

// Perfis de permissão (templates) — independentes do enum Role, para não
// afetar login/sessão. Cada perfil tem um conjunto de permissões por módulo
// (Ver/Criar/Editar/Excluir) e pode ser atribuído a vários usuários.
model PermissionProfile {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modulePermissions ModulePermission[]
  users             User[]
}

model ModulePermission {
  id        String            @id @default(cuid())
  profileId String
  profile   PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  moduleKey String
  canView   Boolean           @default(false)
  canCreate Boolean           @default(false)
  canEdit   Boolean           @default(false)
  canDelete Boolean           @default(false)

  @@unique([profileId, moduleKey])
}

// ---------------------------------------------------------------------------
// EMPRESAS (multiloja) — Grupo Nord > Empresas (Nord Pizza, Zarki Sushi, ...)
// ---------------------------------------------------------------------------

model Empresa {
  id                             String     @id @default(cuid())
  key                            String     @unique
  name                           String
  logo                           String?
  color                          String     @default("#2952E3")
  active                         Boolean    @default(true)
  order                          Int        @default(0)
  driveFolderUrl                 String?
  taxaIfoodPadrao                Float      @default(30)
  metaCmvPercent                 Float      @default(30)
  metaDivergenciaContagemPercent Float      @default(3)
  saiposApiToken                 String?
  saiposLojaId                   String?
  saiposSyncEnabled              Boolean    @default(false)
  saiposLastSyncAt               DateTime?
  metaAdsAccessToken             String?
  metaAdsAdAccountId             String?
  metaAdsAdAccountName           String?
  metaAdsGraphVersion            String     @default("v21.0")
  metaAdsSyncEnabled             Boolean    @default(false)
  metaAdsLastSyncAt              DateTime?
  createdAt                      DateTime   @default(now())
  updatedAt                      DateTime   @updatedAt

  userAccess             UserEmpresaAccess[]
  suppliers              Supplier[]
  purchases              Purchase[]
  receivings             Receiving[]
  transfersOrigem        Transfer[]              @relation("TransferOrigem")
  transfersDestino       Transfer[]              @relation("TransferDestino")
  losses                 Loss[]
  stockCounts            StockCount[]
  actionPlans            ActionPlan[]
  usersDefault           User[]                  @relation("UserDefaultEmpresa")
  salesEntries           SalesEntry[]
  marketingEntries       MarketingEntry[]
  marketingTasks         MarketingTask[]
  marketingCampaigns     MarketingCampaign[]
  marketingFiles         MarketingFile[]
  marketingIdeas         MarketingIdea[]
  goals                  Goal[]
  employees              Employee[]
  waiterSales            WaiterSaleEntry[]
  sales                  Sale[]
  clientes               Cliente[]
  customerNotes          CustomerNote[]
  crmSegments            CrmSegment[]
  campaigns              Campaign[]
  automations            Automation[]
  loyaltyConfig          LoyaltyConfig?
  loyaltyRewards         LoyaltyReward[]
  loyaltyAccounts        LoyaltyAccount[]
  npsResponses           NpsResponse[]
  products               Product[]
  ingredients            Ingredient[]
  stockMovements         StockMovement[]
  bankAccounts           BankAccount[]
  payables               Payable[]
  receivables            Receivable[]
  cashMovements          CashMovement[]
  recurringTemplates     RecurringTemplate[]
  bankTransactions       BankTransaction[]
  reconciliationImports  BankReconciliationImport[]
  auditLogs              AuditLog[]
  trainingTracks         TrainingTrack[]
  trainingCourses        TrainingCourse[]
  trainingLibrary        TrainingLibraryItem[]
  qualityConfigs         CategoryQualityConfig[]
  employeeFinanceEntries EmployeeFinanceEntry[]
  timeEntries            TimeEntry[]
  vacations              Vacation[]
  uniformDeliveries      UniformDelivery[]
  employeeDocuments      EmployeeDocument[]
  saiposSales            SaiposSale[]
  saiposSyncLogs         SaiposSyncLog[]
  metaAdsInsights        MetaAdsInsight[]
  metaAdsSyncLogs        MetaAdsSyncLog[]
}

model UserEmpresaAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, empresaId])
}

// ---------------------------------------------------------------------------
// MENU / CATEGORIES (drag & drop, custom categories)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  icon        String   @default("LayoutGrid")
  color       String   @default("#2952E3")
  order       Int      @default(0)
  active      Boolean  @default(true)
  isSystem    Boolean  @default(false)
  contentType String   @default("custom")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  name       String
  icon       String   @default("Folder")
  color      String   @default("#2952E3")
  order      Int      @default(0)
  active     Boolean  @default(true)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, key])
}

model MenuPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderJson String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// VENDAS
// ---------------------------------------------------------------------------

enum PeriodType {
  DIARIO
  SEMANAL
  MENSAL
}

enum SalesEntrySource {
  MANUAL
  SAIPOS
  IMPORTADO
}

model SalesEntry {
  id                  String            @id @default(cuid())
  empresaId           String
  empresa             Empresa           @relation(fields: [empresaId], references: [id])
  date                DateTime
  periodType          PeriodType        @default(DIARIO)
  source              SalesEntrySource  @default(MANUAL)
  faturamentoDelivery Float             @default(0)
  faturamentoSalao    Float             @default(0)
  pedidosDelivery     Int               @default(0)
  pedidosBalcao       Int               @default(0)
  pedidosSalao        Int               @default(0)
  mesasAtendidas      Int               @default(0)
  taxaServicoValor    Float             @default(0)
  metaDiaria          Float             @default(0)
  observacoes         String?
  createdById         String?
  createdBy           User?             @relation(fields: [createdById], references: [id])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([empresaId, date])
}

// ---------------------------------------------------------------------------
// VENDAS — lançamentos granulares (por venda/pedido), usados para as
// análises de Curva ABC, desempenho por garçom, horário, forma de
// pagamento e área de entrega. Complementa o SalesEntry (agregado diário)
// acima, que continua sendo o lançamento macro do dia.
// ---------------------------------------------------------------------------

enum SaleChannel {
  SALAO
  DELIVERY
  BALCAO
}

enum SalePlatform {
  SITE_PROPRIO
  IFOOD
  FOOD99
}

model Sale {
  id             String        @id @default(cuid())
  empresaId      String
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  dateTime       DateTime
  channel        SaleChannel   @default(SALAO)
  platform       SalePlatform  @default(SITE_PROPRIO)
  formaPagamento PaymentMethod @default(OUTRO)
  garcomId       String?
  garcom         Employee?     @relation(fields: [garcomId], references: [id])
  clienteId      String?
  cliente        Cliente?      @relation(fields: [clienteId], references: [id])
  mesaNumero     String?
  bairro         String?
  regiao         String?
  valorTotal     Float         @default(0)
  cancelado      Boolean       @default(false)
  createdById    String
  createdBy      User          @relation("SaleCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  items SaleItem[]

  @@index([empresaId, dateTime])
}

// ---------------------------------------------------------------------------
// SAIPOS — vendas importadas da API de Dados da Saipos (GET /v1/search_sales)
// ---------------------------------------------------------------------------

model SaiposSale {
  id             String        @id @default(cuid())
  empresaId      String
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  saiposId       String
  shiftDate      DateTime
  dateTime       DateTime
  channel        SaleChannel   @default(SALAO)
  platform       SalePlatform  @default(SITE_PROPRIO)
  formaPagamento PaymentMethod @default(OUTRO)
  valorTotal     Float         @default(0)
  cancelado      Boolean       @default(false)
  raw            Json?
  createdAt      DateTime      @default(now())

  @@unique([empresaId, saiposId])
  @@index([empresaId, shiftDate])
}

model SaiposSyncLog {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String
  recordsSynced Int       @default(0)
  errorMessage  String?

  @@index([empresaId, startedAt])
}

model MetaAdsInsight {
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  dateStart         DateTime
  dateStop          DateTime
  campaignId        String
  campaignName      String
  publisherPlatform String   @default("")
  platformPosition  String   @default("")
  spend             Float    @default(0)
  impressions       Int      @default(0)
  reach             Int      @default(0)
  clicks            Int      @default(0)
  linkClicks        Int      @default(0)
  landingPageViews  Int      @default(0)
  purchases         Int      @default(0)
  purchaseValue     Float    @default(0)
  raw               Json?
  createdAt         DateTime @default(now())

  @@unique([empresaId, dateStart, dateStop, campaignId, publisherPlatform, platformPosition])
  @@index([empresaId, dateStart])
}

model MetaAdsSyncLog {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  status        String
  recordsSynced Int       @default(0)
  errorMessage  String?

  @@index([empresaId, startedAt])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Cliente {
  id             String       @id @default(cuid())
  empresaId      String
  empresa        Empresa      @relation(fields: [empresaId], references: [id])
  nome           String
  telefone       String?
  whatsapp       String?
  email          String?
  dataNascimento DateTime?
  endereco       String?
  bairro         String?
  cidade         String?
  canalPreferido SaleChannel?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  vendas             Sale[]
  notas              CustomerNote[]
  campaignRecipients CampaignRecipient[]
  npsResponses       NpsResponse[]
  loyaltyAccount     LoyaltyAccount?

  @@unique([empresaId, telefone])
  @@index([empresaId, dataNascimento])
}

model CustomerNote {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  clienteId String
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  texto     String
  authorId  String
  author    User     @relation("CustomerNoteAuthor", fields: [authorId], references: [id])
  createdAt DateTime @default(now())

  @@index([clienteId])
}

// ---------------------------------------------------------------------------
// CRM — SEGMENTOS
// ---------------------------------------------------------------------------

model CrmSegment {
  id          String   @id @default(cuid())
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  name        String
  description String?
  criteria    Json
  createdById String
  createdBy   User     @relation("CrmSegmentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  campaigns Campaign[]

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// CRM — CAMPANHAS
// ---------------------------------------------------------------------------

enum CampaignAudienceType {
  TODOS
  SEGMENTO
  CLIENTES
}

enum CampaignChannel {
  WHATSAPP
  SMS
  EMAIL
  PUSH
}

enum CampaignOfferType {
  CUPOM
  DESCONTO_PERCENTUAL
  DESCONTO_VALOR
  PRODUTO_GRATIS
  CASHBACK
  PONTOS
  SEM_OFERTA
}

enum CampaignStatus {
  RASCUNHO
  AGENDADA
  ENVIADA
  CONCLUIDA
}

model Campaign {
  id               String               @id @default(cuid())
  empresaId        String
  empresa          Empresa              @relation(fields: [empresaId], references: [id])
  name             String
  status           CampaignStatus       @default(RASCUNHO)
  audienceType     CampaignAudienceType @default(TODOS)
  segmentId        String?
  segment          CrmSegment?          @relation(fields: [segmentId], references: [id])
  channel          CampaignChannel      @default(WHATSAPP)
  offerType        CampaignOfferType    @default(SEM_OFERTA)
  offerValue       Float?
  offerDescription String?
  message          String
  scheduledAt      DateTime?
  sentAt           DateTime?
  createdById      String
  createdBy        User                 @relation("CampaignCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  recipients CampaignRecipient[]

  @@index([empresaId, status])
}

enum CampaignRecipientStatus {
  PENDENTE
  ENVIADO
  ENTREGUE
  VISUALIZADO
  CLICOU
  CONVERTEU
}

model CampaignRecipient {
  id         String                  @id @default(cuid())
  campaignId String
  campaign   Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  clienteId  String
  cliente    Cliente                 @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  status     CampaignRecipientStatus @default(PENDENTE)
  createdAt  DateTime                @default(now())

  @@unique([campaignId, clienteId])
  @@index([campaignId])
}

// ---------------------------------------------------------------------------
// CRM — AUTOMAÇÕES
// ---------------------------------------------------------------------------

enum AutomationTrigger {
  PRIMEIRA_COMPRA
  SEGUNDA_COMPRA
  INATIVO_30
  INATIVO_60
  INATIVO_90
  ANIVERSARIO
  CLIENTE_VIP
  POS_VENDA
  AVALIACAO
  RECUPERACAO
}

enum AutomationActionType {
  MENSAGEM
  TAG
  OFERTA
}

model Automation {
  id          String               @id @default(cuid())
  empresaId   String
  empresa     Empresa              @relation(fields: [empresaId], references: [id])
  name        String
  trigger     AutomationTrigger
  active      Boolean              @default(true)
  waitDays    Int                  @default(0)
  actionType  AutomationActionType @default(MENSAGEM)
  message     String?
  createdById String
  createdBy   User                 @relation("AutomationCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([empresaId])
}

// ---------------------------------------------------------------------------
// CRM — FIDELIDADE (CLUBE NORD)
// ---------------------------------------------------------------------------

model LoyaltyConfig {
  id            String   @id @default(cuid())
  empresaId     String   @unique
  empresa       Empresa  @relation(fields: [empresaId], references: [id])
  pontosPorReal Float    @default(1)
  updatedAt     DateTime @updatedAt
}

model LoyaltyReward {
  id                String   @id @default(cuid())
  empresaId         String
  empresa           Empresa  @relation(fields: [empresaId], references: [id])
  name              String
  pontosNecessarios Int
  ativo             Boolean  @default(true)
  createdAt         DateTime @default(now())

  @@index([empresaId])
}

model LoyaltyAccount {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  clienteId String   @unique
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  pontos    Int      @default(0)
  cashback  Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transacoes LoyaltyTransaction[]

  @@index([empresaId])
}

enum LoyaltyTransactionType {
  GANHO
  RESGATE
}

model LoyaltyTransaction {
  id        String                 @id @default(cuid())
  accountId String
  account   LoyaltyAccount         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tipo      LoyaltyTransactionType
  pontos    Int                    @default(0)
  cashback  Float                  @default(0)
  descricao String?
  createdAt DateTime               @default(now())

  @@index([accountId])
}

// ---------------------------------------------------------------------------
// CRM — SATISFAÇÃO / NPS
// ---------------------------------------------------------------------------

enum NpsStatus {
  PENDENTE
  EM_CONTATO
  RESOLVIDO
}

model NpsResponse {
  id            String    @id @default(cuid())
  empresaId     String
  empresa       Empresa   @relation(fields: [empresaId], references: [id])
  clienteId     String?
  cliente       Cliente?  @relation(fields: [clienteId], references: [id])
  saleId        String?
  nota          Int
  comentario    String?
  status        NpsStatus @default(PENDENTE)
  responsavelId String?
  responsavel   User?     @relation("NpsResponsavel", fields: [responsavelId], references: [id])
  createdAt     DateTime  @default(now())

  @@index([empresaId, createdAt])
}

model SaleItem {
  id            String           @id @default(cuid())
  saleId        String
  sale          Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  nome          String
  categoria     ProductCategory?
  quantidade    Float
  precoUnitario Float
  faturamento   Float

  @@index([saleId])
}

// ---------------------------------------------------------------------------
// MARKETING
// ---------------------------------------------------------------------------

enum MarketingEntrySource {
  MANUAL
  META_ADS
}

model MarketingEntry {
  id                  String               @id @default(cuid())
  empresaId           String
  empresa             Empresa              @relation(fields: [empresaId], references: [id])
  date                DateTime
  source              MarketingEntrySource @default(MANUAL)
  investimentoTrafego Float    @default(0)
  receitaTrafego      Float    @default(0)
  pedidosCampanha     Int      @default(0)
  visitasSite         Int      @default(0)
  conversoes          Int      @default(0)
  seguidoresInicio    Int      @default(0)
  seguidoresFim       Int      @default(0)
  curtidas            Int      @default(0)
  comentarios         Int      @default(0)
  compartilhamentos   Int      @default(0)
  salvamentos         Int      @default(0)
  alcance             Int      @default(0)
  impressoes          Int      @default(0)
  observacoes         String?
  planoDeAcao         String?
  createdById         String?
  createdBy           User?    @relation(fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// MARKETING OS — calendário de conteúdo, tarefas (kanban), campanhas,
// biblioteca de arquivos e banco de ideias
// ---------------------------------------------------------------------------

enum MarketingStatus {
  IDEIA
  A_PRODUZIR
  EM_PRODUCAO
  EM_EDICAO
  EM_ANALISE
  AGENDADO
  PUBLICADO
  RESULTADOS
}

enum MarketingPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum MarketingCampaignStatus {
  PLANEJADA
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
}

enum MarketingIdeaStatus {
  NOVA
  EM_AVALIACAO
  APROVADA
  DESCARTADA
}

model MarketingTask {
  id               String             @id @default(cuid())
  empresaId        String
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  title            String
  description      String?
  objetivo         String?
  category         String?
  socialNetwork    String?
  format           String?
  status           MarketingStatus    @default(A_PRODUZIR)
  priority         MarketingPriority  @default(MEDIA)
  date             DateTime?
  time             String?
  responsavelId    String?
  responsavel      User?              @relation("MarketingTaskResponsavel", fields: [responsavelId], references: [id])
  checklist        String?
  tags             String?
  estimatedMinutes Int?
  actualMinutes    Int?
  recurrenceRule   String?
  campaignId       String?
  campaign         MarketingCampaign? @relation(fields: [campaignId], references: [id])
  order            Int                @default(0)
  createdById      String
  createdBy        User               @relation("MarketingTaskCreatedBy", fields: [createdById], references: [id])
