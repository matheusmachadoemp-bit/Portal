// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// AUTH / USERS / PERMISSIONS
// ---------------------------------------------------------------------------

enum Role {
  ADMINISTRADOR
  GESTOR
  GERENTE
  SUPERVISOR
  COLABORADOR
}

enum AccessLevel {
  NENHUM
  VISUALIZAR
  EDITAR
  TOTAL
}

model User {
  id                  String             @id @default(cuid())
  name                String
  email               String             @unique
  passwordHash        String
  role                Role               @default(COLABORADOR)
  active              Boolean            @default(true)
  avatarUrl           String?
  phone               String?
  resetToken          String?
  resetTokenExp       DateTime?
  lastLoginAt         DateTime?
  canViewGrupoNord    Boolean            @default(false)
  defaultEmpresaId    String?
  defaultEmpresa      Empresa?           @relation("UserDefaultEmpresa", fields: [defaultEmpresaId], references: [id])
  permissionProfileId String?
  permissionProfile   PermissionProfile? @relation(fields: [permissionProfileId], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  permissions                   UserPermission[]
  empresaAccess                 UserEmpresaAccess[]
  menuPreferences               MenuPreference?
  auditLogs                     AuditLog[]
  salesEntries                  SalesEntry[]
  marketingEntries              MarketingEntry[]
  marketingTasksResponsavel     MarketingTask[]        @relation("MarketingTaskResponsavel")
  marketingTasksCreated         MarketingTask[]        @relation("MarketingTaskCreatedBy")
  marketingComments             MarketingComment[]
  marketingCampaignsResponsavel MarketingCampaign[]    @relation("MarketingCampaignResponsavel")
  marketingCampaignsCreated     MarketingCampaign[]    @relation("MarketingCampaignCreatedBy")
  marketingFiles                MarketingFile[]
  marketingIdeas                MarketingIdea[]
  goals                         Goal[]
  waiterSalesCreated            WaiterSaleEntry[]      @relation("WaiterSaleCreatedBy")
  stockMovementsCreated         StockMovement[]        @relation("StockMovementCreatedBy")
  salesCreated                  Sale[]                 @relation("SaleCreatedBy")
  vaultEntries                  VaultEntry[]
  vaultAccess                   VaultAccessLog[]
  courses                       Course[]
  files                         FileItem[]
  products                      Product[]
  occurrences                   Occurrence[]           @relation("OccurrenceCreatedBy")
  rhFinanceEntries              EmployeeFinanceEntry[] @relation("RhFinanceCreatedBy")
  vacationsCreated              Vacation[]             @relation("VacationCreatedBy")
  uniformDeliveriesCreated      UniformDelivery[]      @relation("UniformCreatedBy")
  employeeDocumentsCreated      EmployeeDocument[]     @relation("EmployeeDocumentCreatedBy")
  payables                      Payable[]
  receivables                   Receivable[]
  cashMovements                 CashMovement[]
  recurringTemplates            RecurringTemplate[]
  trainingCoursesCreated        TrainingCourse[]
  trainingEnrollments           TrainingEnrollment[]
  trainingAttempts              TrainingAttempt[]
  trainingCertificates          TrainingCertificate[]
  trainingBadges                TrainingUserBadge[]
  trainingXpEvents              TrainingXpEvent[]
  trainingLibraryItems          TrainingLibraryItem[]
}

model UserPermission {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  moduleKey String
  level     AccessLevel @default(VISUALIZAR)
  createdAt DateTime    @default(now())

  @@unique([userId, moduleKey])
}

// Perfis de permissão (templates) — independentes do enum Role, para não
// afetar login/sessão. Cada perfil tem um conjunto de permissões por módulo
// (Ver/Criar/Editar/Excluir) e pode ser atribuído a vários usuários.
model PermissionProfile {
  id        String   @id @default(cuid())
  key       String   @unique
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  modulePermissions ModulePermission[]
  users             User[]
}

model ModulePermission {
  id        String            @id @default(cuid())
  profileId String
  profile   PermissionProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  moduleKey String
  canView   Boolean           @default(false)
  canCreate Boolean           @default(false)
  canEdit   Boolean           @default(false)
  canDelete Boolean           @default(false)

  @@unique([profileId, moduleKey])
}

// ---------------------------------------------------------------------------
// EMPRESAS (multiloja) — Grupo Nord > Empresas (Nord Pizza, Zarki Sushi, ...)
// ---------------------------------------------------------------------------

model Empresa {
  id              String   @id @default(cuid())
  key             String   @unique
  name            String
  logo            String?
  color           String   @default("#2952E3")
  active          Boolean  @default(true)
  order           Int      @default(0)
  driveFolderUrl  String?
  taxaIfoodPadrao Float    @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  userAccess             UserEmpresaAccess[]
  usersDefault           User[]                  @relation("UserDefaultEmpresa")
  salesEntries           SalesEntry[]
  marketingEntries       MarketingEntry[]
  marketingTasks         MarketingTask[]
  marketingCampaigns     MarketingCampaign[]
  marketingFiles         MarketingFile[]
  marketingIdeas         MarketingIdea[]
  goals                  Goal[]
  employees              Employee[]
  waiterSales            WaiterSaleEntry[]
  sales                  Sale[]
  clientes               Cliente[]
  products               Product[]
  ingredients            Ingredient[]
  stockMovements         StockMovement[]
  bankAccounts           BankAccount[]
  payables               Payable[]
  receivables            Receivable[]
  cashMovements          CashMovement[]
  recurringTemplates     RecurringTemplate[]
  auditLogs              AuditLog[]
  trainingTracks         TrainingTrack[]
  trainingCourses        TrainingCourse[]
  trainingLibrary        TrainingLibraryItem[]
  qualityConfigs         CategoryQualityConfig[]
  employeeFinanceEntries EmployeeFinanceEntry[]
  timeEntries            TimeEntry[]
  vacations              Vacation[]
  uniformDeliveries      UniformDelivery[]
  employeeDocuments      EmployeeDocument[]
}

model UserEmpresaAccess {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, empresaId])
}

// ---------------------------------------------------------------------------
// MENU / CATEGORIES (drag & drop, custom categories)
// ---------------------------------------------------------------------------

model Category {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  icon        String   @default("LayoutGrid")
  color       String   @default("#2952E3")
  order       Int      @default(0)
  active      Boolean  @default(true)
  isSystem    Boolean  @default(false)
  contentType String   @default("custom")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  subcategories Subcategory[]
}

model Subcategory {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  key        String
  name       String
  icon       String   @default("Folder")
  color      String   @default("#2952E3")
  order      Int      @default(0)
  active     Boolean  @default(true)
  isSystem   Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([categoryId, key])
}

model MenuPreference {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderJson String
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// VENDAS
// ---------------------------------------------------------------------------

enum PeriodType {
  DIARIO
  SEMANAL
  MENSAL
}

model SalesEntry {
  id                  String     @id @default(cuid())
  empresaId           String
  empresa             Empresa    @relation(fields: [empresaId], references: [id])
  date                DateTime
  periodType          PeriodType @default(DIARIO)
  faturamentoDelivery Float      @default(0)
  faturamentoSalao    Float      @default(0)
  pedidosDelivery     Int        @default(0)
  pedidosBalcao       Int        @default(0)
  pedidosSalao        Int        @default(0)
  mesasAtendidas      Int        @default(0)
  taxaServicoValor    Float      @default(0)
  metaDiaria          Float      @default(0)
  observacoes         String?
  createdById         String
  createdBy           User       @relation(fields: [createdById], references: [id])
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
}

// ---------------------------------------------------------------------------
// VENDAS — lançamentos granulares (por venda/pedido), usados para as
// análises de Curva ABC, desempenho por garçom, horário, forma de
// pagamento e área de entrega. Complementa o SalesEntry (agregado diário)
// acima, que continua sendo o lançamento macro do dia.
// ---------------------------------------------------------------------------

enum SaleChannel {
  SALAO
  DELIVERY
  BALCAO
}

model Sale {
  id             String        @id @default(cuid())
  empresaId      String
  empresa        Empresa       @relation(fields: [empresaId], references: [id])
  dateTime       DateTime
  channel        SaleChannel   @default(SALAO)
  formaPagamento PaymentMethod @default(OUTRO)
  garcomId       String?
  garcom         Employee?     @relation(fields: [garcomId], references: [id])
  clienteId      String?
  cliente        Cliente?      @relation(fields: [clienteId], references: [id])
  mesaNumero     String?
  bairro         String?
  regiao         String?
  valorTotal     Float         @default(0)
  createdById    String
  createdBy      User          @relation("SaleCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime      @default(now())

  items SaleItem[]

  @@index([empresaId, dateTime])
}

// ---------------------------------------------------------------------------
// CRM
// ---------------------------------------------------------------------------

model Cliente {
  id        String   @id @default(cuid())
  empresaId String
  empresa   Empresa  @relation(fields: [empresaId], references: [id])
  nome      String
  telefone  String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  vendas Sale[]

  @@unique([empresaId, telefone])
}

model SaleItem {
  id            String           @id @default(cuid())
  saleId        String
  sale          Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?         @relation(fields: [productId], references: [id])
  nome          String
  categoria     ProductCategory?
  quantidade    Float
  precoUnitario Float
  faturamento   Float

  @@index([saleId])
}

// ---------------------------------------------------------------------------
// MARKETING
// ---------------------------------------------------------------------------

model MarketingEntry {
  id                  String   @id @default(cuid())
  empresaId           String
  empresa             Empresa  @relation(fields: [empresaId], references: [id])
  date                DateTime
  investimentoTrafego Float    @default(0)
  receitaTrafego      Float    @default(0)
  pedidosCampanha     Int      @default(0)
  visitasSite         Int      @default(0)
  conversoes          Int      @default(0)
  seguidoresInicio    Int      @default(0)
  seguidoresFim       Int      @default(0)
  curtidas            Int      @default(0)
  comentarios         Int      @default(0)
  compartilhamentos   Int      @default(0)
  salvamentos         Int      @default(0)
  alcance             Int      @default(0)
  impressoes          Int      @default(0)
  observacoes         String?
  planoDeAcao         String?
  createdById         String
  createdBy           User     @relation(fields: [createdById], references: [id])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// MARKETING OS — calendário de conteúdo, tarefas (kanban), campanhas,
// biblioteca de arquivos e banco de ideias
// ---------------------------------------------------------------------------

enum MarketingStatus {
  IDEIA
  A_PRODUZIR
  EM_PRODUCAO
  EM_EDICAO
  EM_ANALISE
  AGENDADO
  PUBLICADO
  RESULTADOS
}

enum MarketingPriority {
  BAIXA
  MEDIA
  ALTA
  URGENTE
}

enum MarketingCampaignStatus {
  PLANEJADA
  EM_ANDAMENTO
  PAUSADA
  CONCLUIDA
}

enum MarketingIdeaStatus {
  NOVA
  EM_AVALIACAO
  APROVADA
  DESCARTADA
}

model MarketingTask {
  id               String             @id @default(cuid())
  empresaId        String
  empresa          Empresa            @relation(fields: [empresaId], references: [id])
  title            String
  description      String?
  objetivo         String?
  category         String?
  socialNetwork    String?
  format           String?
  status           MarketingStatus    @default(A_PRODUZIR)
  priority         MarketingPriority  @default(MEDIA)
  date             DateTime?
  time             String?
  responsavelId    String?
  responsavel      User?              @relation("MarketingTaskResponsavel", fields: [responsavelId], references: [id])
  checklist        String?
  tags             String?
  estimatedMinutes Int?
  actualMinutes    Int?
  recurrenceRule   String?
  campaignId       String?
  campaign         MarketingCampaign? @relation(fields: [campaignId], references: [id])
  order            Int                @default(0)
  createdById      String
  createdBy        User               @relation("MarketingTaskCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  comments MarketingComment[]
  files    MarketingFile[]
}

model MarketingComment {
  id        String        @id @default(cuid())
  taskId    String
  task      MarketingTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  text      String
  createdAt DateTime      @default(now())
}

model MarketingCampaign {
  id            String                  @id @default(cuid())
  empresaId     String
  empresa       Empresa                 @relation(fields: [empresaId], references: [id])
  name          String
  objective     String?
  startDate     DateTime
  endDate       DateTime
  budget        Float                   @default(0)
  investimento  Float                   @default(0)
  retorno       Float                   @default(0)
  responsavelId String?
  responsavel   User?                   @relation("MarketingCampaignResponsavel", fields: [responsavelId], references: [id])
  status        MarketingCampaignStatus @default(PLANEJADA)
  resultados    String?
  createdById   String
  createdBy     User                    @relation("MarketingCampaignCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  tasks MarketingTask[]
}

model MarketingFile {
  id           String         @id @default(cuid())
  empresaId    String
  empresa      Empresa        @relation(fields: [empresaId], references: [id])
  name         String
  category     String         @default("Artes")
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  tags         String?
  taskId       String?
  task         MarketingTask? @relation(fields: [taskId], references: [id], onDelete: SetNull)
  uploadedById String
  uploadedBy   User           @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime       @default(now())
}

model MarketingIdea {
  id          String              @id @default(cuid())
  empresaId   String
  empresa     Empresa             @relation(fields: [empresaId], references: [id])
  title       String
  description String?
  references  String?
  links       String?
  category    String?
  tags        String?
  status      MarketingIdeaStatus @default(NOVA)
  createdById String
  createdBy   User                @relation(fields: [createdById], references: [id])
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

// ---------------------------------------------------------------------------
// METAS
// ---------------------------------------------------------------------------

enum GoalCategory {
  GERENCIA
  SALAO
  COZINHA
  DELIVERY
  MARKETING
  ADMINISTRATIVO
}

enum GoalStatus {
  NAO_INICIADA
  EM_ANDAMENTO
  EM_RISCO
  CONCLUIDA
  NAO_ATINGIDA
}

model Goal {
  id             String       @id @default(cuid())
  empresaId      String
  empresa        Empresa      @relation(fields: [empresaId], references: [id])
  name           String
  category       GoalCategory
  responsavel    String
  description    String?
  indicador      String?
  valorMeta      Float        @default(0)
  valorRealizado Float        @default(0)
  unidade        String       @default("R$")
  startDate      DateTime
  endDate        DateTime
  bonificacao    String?
  status         GoalStatus   @default(NAO_INICIADA)
  observacoes    String?
  planoDeAcao    String?
  createdById    String
  createdBy      User         @relation(fields: [createdById], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  attachments GoalAttachment[]
}

model GoalAttachment {
  id        String   @id @default(cuid())
  goalId    String
  goal      Goal     @relation(fields: [goalId], references: [id], onDelete: Cascade)
  fileName  String
  fileUrl   String
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// RH
// ---------------------------------------------------------------------------

enum EmployeeStatus {
  ATIVO
  FERIAS
  AFASTADO
  DESLIGADO
}

model Employee {
  id                    String         @id @default(cuid())
  empresaId             String
  empresa               Empresa        @relation(fields: [empresaId], references: [id])
  name                  String
  cargo                 String
  setor                 String
  photoUrl              String?
  admissionDate         DateTime
  terminationDate       DateTime?
  status                EmployeeStatus @default(ATIVO)
  phone                 String?
  email                 String?
  cpf                   String?
  birthDate             DateTime?
  escala                String?
  gestorResponsavel     String?
  supervisorResponsavel String?
  salarioFixo           Float?
  lastEvaluationDate    DateTime?
  lastEvaluationNote    String?
  lastTrainingDate      DateTime?
  lastTrainingName      String?
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  occurrences       Occurrence[]
  waiterSales       WaiterSaleEntry[]
  sales             Sale[]
  financeEntries    EmployeeFinanceEntry[]
  timeEntries       TimeEntry[]
  vacations         Vacation[]
  uniformDeliveries UniformDelivery[]
  documents         EmployeeDocument[]
}

// ---------------------------------------------------------------------------
// VENDA ACUMULADA (garçons)
// ---------------------------------------------------------------------------

model WaiterSaleEntry {
  id          String   @id @default(cuid())
  employeeId  String
  employee    Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id])
  amount      Float
  date        DateTime
  note        String?
  createdById String
  createdBy   User     @relation("WaiterSaleCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([employeeId])
}

enum OccurrenceType {
  FALTA
  ATRASO
  ATESTADO
  ADVERTENCIA
  SUSPENSAO
  ELOGIO
  ACIDENTE
  RECLAMACAO
  CONFLITO_INTERNO
  FEEDBACK
}

enum OccurrenceStatus {
  PENDENTE
  JUSTIFICADA
  NAO_JUSTIFICADA
}

model Occurrence {
  id               String           @id @default(cuid())
  employeeId       String
  employee         Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date             DateTime
  type             OccurrenceType
  horarioPrevisto  String?
  horarioRealizado String?
  minutosAtraso    Int              @default(0)
  justificativa    String?
  medidasTomadas   String?
  prazo            DateTime?
  anexoUrl         String?
  observacao       String?
  status           OccurrenceStatus @default(PENDENTE)
  createdById      String
  createdBy        User             @relation("OccurrenceCreatedBy", fields: [createdById], references: [id])
  createdAt        DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// RH — FINANCEIRO DO COLABORADOR
// ---------------------------------------------------------------------------

enum RhFinanceType {
  SALARIO
  COMISSAO
  BONIFICACAO
  DESCONTO
  VALE_TRANSPORTE
  VALE_ALIMENTACAO
  OUTRO
}

model EmployeeFinanceEntry {
  id          String        @id @default(cuid())
  employeeId  String
  employee    Employee      @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empresaId   String
  empresa     Empresa       @relation(fields: [empresaId], references: [id])
  date        DateTime
  description String
  type        RhFinanceType
  value       Float
  observacao  String?
  createdById String
  createdBy   User          @relation("RhFinanceCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// RH — PONTO ELETRÔNICO
// ---------------------------------------------------------------------------

model TimeEntry {
  id               String   @id @default(cuid())
  employeeId       String
  employee         Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empresaId        String
  empresa          Empresa  @relation(fields: [empresaId], references: [id])
  date             DateTime
  entrada          String?
  saidaAlmoco      String?
  retornoAlmoco    String?
  saida            String?
  horasTrabalhadas Float    @default(0)
  atrasoMinutos    Int      @default(0)
  falta            Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@unique([employeeId, date])
}

// ---------------------------------------------------------------------------
// RH — FÉRIAS
// ---------------------------------------------------------------------------

enum VacationStatus {
  PLANEJADA
  APROVADA
  EM_ANDAMENTO
  CONCLUIDA
  CANCELADA
}

model Vacation {
  id                      String         @id @default(cuid())
  employeeId              String
  employee                Employee       @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empresaId               String
  empresa                 Empresa        @relation(fields: [empresaId], references: [id])
  periodoAquisitivoInicio DateTime
  periodoAquisitivoFim    DateTime
  diasDireito             Int            @default(30)
  dataInicio              DateTime?
  dataFim                 DateTime?
  dias                    Int?
  status                  VacationStatus @default(PLANEJADA)
  observacao              String?
  createdById             String
  createdBy               User           @relation("VacationCreatedBy", fields: [createdById], references: [id])
  createdAt               DateTime       @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// RH — UNIFORMES
// ---------------------------------------------------------------------------

enum UniformItemType {
  CAMISA
  CALCA
  AVENTAL
  BONE
  TOUCA
  SAPATO
  CINTO
  OUTRO
}

enum UniformStatus {
  ENTREGUE
  TROCADO
  DEVOLVIDO
  PERDIDO
}

model UniformDelivery {
  id          String          @id @default(cuid())
  employeeId  String
  employee    Employee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empresaId   String
  empresa     Empresa         @relation(fields: [empresaId], references: [id])
  item        UniformItemType
  quantidade  Int             @default(1)
  tamanho     String?
  dataEntrega DateTime
  responsavel String?
  status      UniformStatus   @default(ENTREGUE)
  observacao  String?
  createdById String
  createdBy   User            @relation("UniformCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime        @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// RH — DOCUMENTOS
// ---------------------------------------------------------------------------

enum DocumentCategory {
  RG
  CPF
  CTPS
  COMPROVANTE_RESIDENCIA
  TITULO_ELEITOR
  RESERVISTA
  EXAME_ADMISSIONAL
  ASO
  CNH
  CONTRATO
  TERMO
  CERTIFICADO
  TREINAMENTO
  OUTRO
}

model EmployeeDocument {
  id          String           @id @default(cuid())
  employeeId  String
  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  empresaId   String
  empresa     Empresa          @relation(fields: [empresaId], references: [id])
  categoria   DocumentCategory
  nome        String
  fileUrl     String
  mimeType    String?
  validade    DateTime?
  observacao  String?
  createdById String
  createdBy   User             @relation("EmployeeDocumentCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime         @default(now())

  @@index([employeeId])
}

// ---------------------------------------------------------------------------
// ADMINISTRATIVO
// ---------------------------------------------------------------------------

model VaultEntry {
  id             String   @id @default(cuid())
  systemName     String
  site           String?
  username       String
  passwordCipher String
  category       String   @default("Geral")
  responsavel    String?
  observacao     String?
  createdById    String
  createdBy      User     @relation(fields: [createdById], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  history VaultHistory[]
  access  VaultAccessLog[]
}

model VaultHistory {
  id           String     @id @default(cuid())
  vaultEntryId String
  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  changedBy    String
  changeType   String
  createdAt    DateTime   @default(now())
}

model VaultAccessLog {
  id           String     @id @default(cuid())
  vaultEntryId String
  vaultEntry   VaultEntry @relation(fields: [vaultEntryId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation(fields: [userId], references: [id])
  action       String
  createdAt    DateTime   @default(now())
}

model Course {
  id                  String    @id @default(cuid())
  name                String
  plataforma          String?
  link                String?
  usuario             String?
  senha               String?
  responsavel         String?
  percentualConcluido Int       @default(0)
  startDate           DateTime?
  prazo               DateTime?
  certificadoUrl      String?
  observacoes         String?
  createdById         String
  createdBy           User      @relation(fields: [createdById], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

enum FileFolderType {
  ARQUIVO
  CARTILHA
  LOGO
}

model FileItem {
  id          String         @id @default(cuid())
  name        String
  folderType  FileFolderType @default(ARQUIVO)
  parentId    String?
  parent      FileItem?      @relation("FileTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    FileItem[]     @relation("FileTree")
  isFolder    Boolean        @default(false)
  fileUrl     String?
  mimeType    String?
  sizeBytes   Int?
  version     Int            @default(1)
  createdById String
  createdBy   User           @relation(fields: [createdById], references: [id])
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

// ---------------------------------------------------------------------------
// FICHA TECNICA
// ---------------------------------------------------------------------------

enum ProductCategory {
  PIZZA_SALGADA
  PIZZA_DOCE
  COMBO
  ESFIHA_SALGADA
  ESFIHA_DOCE
  ACOMPANHAMENTO
  BURGER
  BEBIDA
  DRINK
  SOBREMESA
}

model Ingredient {
  id                  String    @id @default(cuid())
  empresaId           String
  empresa             Empresa   @relation(fields: [empresaId], references: [id])
  name                String
  fornecedor          String?
  unidade             String    @default("g")
  precoAtual          Float     @default(0)
  quantidadeEmbalagem Float     @default(1)
  percentualPerda     Float     @default(0)
  estoqueMinimo       Float     @default(0)
  estoqueAtual        Float     @default(0)
  validade            DateTime?
  lastPurchaseDate    DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  priceHistory IngredientPriceHistory[]
  productLinks ProductIngredient[]
  movements    StockMovement[]
}

model IngredientPriceHistory {
  id           String     @id @default(cuid())
  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  price        Float
  createdAt    DateTime   @default(now())
}

enum StockMovementType {
  ENTRADA
  SAIDA
  AJUSTE
  PERDA
  TRANSFERENCIA
  INVENTARIO
}

model StockMovement {
  id           String            @id @default(cuid())
  ingredientId String
  ingredient   Ingredient        @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  empresaId    String
  empresa      Empresa           @relation(fields: [empresaId], references: [id])
  type         StockMovementType
  quantidade   Float
  estoqueApos  Float
  motivo       String?
  createdById  String
  createdBy    User              @relation("StockMovementCreatedBy", fields: [createdById], references: [id])
  createdAt    DateTime          @default(now())

  @@index([ingredientId])
}

model Product {
  id           String          @id @default(cuid())
  empresaId    String
  empresa      Empresa         @relation(fields: [empresaId], references: [id])
  name         String
  code         String          @unique
  category     ProductCategory
  photoUrl     String?
  description  String?
  rendimento   String?
  tamanho      String?
  pesoFinal    Float?
  precoVenda   Float           @default(0)
  taxaIfood    Float?
  modoPreparo  String?
  tempoPreparo Int?
  validade     String?
  responsavel  String?
  createdById  String
  createdBy    User            @relation(fields: [createdById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  ingredients ProductIngredient[]
  saleItems   SaleItem[]
}

model ProductIngredient {
  id              String     @id @default(cuid())
  productId       String
  product         Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  ingredientId    String
  ingredient      Ingredient @relation(fields: [ingredientId], references: [id])
  order           Int        @default(0)
  quantidadeUsada Float
  percentualPerda Float      @default(0)
}

model CategoryQualityConfig {
  id                String          @id @default(cuid())
  empresaId         String
  empresa           Empresa         @relation(fields: [empresaId], references: [id])
  category          ProductCategory
  cmvMaximoPercent  Float           @default(35)
  diasDesatualizada Int             @default(90)
  updatedAt         DateTime        @updatedAt

  @@unique([empresaId, category])
}

// ---------------------------------------------------------------------------
// FINANCEIRO
// ---------------------------------------------------------------------------

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_DEBITO
  CARTAO_CREDITO
  VOUCHER
  TED
  DOC
  TRANSFERENCIA
  CHEQUE
  OUTRO
}

enum FinanceEntryStatus {
  EM_ABERTO
  PAGO
  PARCIALMENTE_PAGO
  CANCELADO
  ATRASADO
}

enum FinanceCategoryType {
  RECEITA
  DESPESA
  CUSTO
  INVESTIMENTO
}

enum CashMovementType {
  ENTRADA
  SAIDA
  TRANSFERENCIA
  APORTE_SOCIO
  RETIRADA_SOCIO
}

model BankAccount {
  id           String   @id @default(cuid())
  empresaId    String
  empresa      Empresa  @relation(fields: [empresaId], references: [id])
  name         String
  bank         String?
  agencia      String?
  conta        String?
  tipo         String   @default("Conta Corrente")
  saldoInicial Float    @default(0)
  saldoAtual   Float    @default(0)
  color        String   @default("#2952E3")
  icon         String   @default("Landmark")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  payables             Payable[]
  receivables          Receivable[]
  cashMovements        CashMovement[]      @relation("CashMovementAccount")
  cashMovementsDestino CashMovement[]      @relation("CashMovementDestino")
  recurringTemplates   RecurringTemplate[]
}

model FinancialCategory {
  id        String              @id @default(cuid())
  name      String              @unique
  type      FinanceCategoryType @default(DESPESA)
  dreKey    String
  active    Boolean             @default(true)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  payables           Payable[]
  receivables        Receivable[]
  recurringTemplates RecurringTemplate[]
}

model FinanceAttachment {
  id         String   @id @default(cuid())
  entityType String // PAYABLE | RECEIVABLE
  entityId   String
  fileName   String
  fileUrl    String
  createdAt  DateTime @default(now())
}

model RecurringTemplate {
  id                String            @id @default(cuid())
  tipo              String // PAGAR | RECEBER
  descricao         String
  fornecedorCliente String?
  categoriaId       String
  categoria         FinancialCategory @relation(fields: [categoriaId], references: [id])
  empresaId         String
  empresa           Empresa           @relation(fields: [empresaId], references: [id])
  centroCusto       String?
  valor             Float
  diaVencimento     Int
  bankAccountId     String
  bankAccount       BankAccount       @relation(fields: [bankAccountId], references: [id])
  formaPagamento    PaymentMethod     @default(PIX)
  infinita          Boolean           @default(false)
  quantidadeMeses   Int?
  dataInicio        DateTime
  active            Boolean           @default(true)
  createdById       String
  createdBy         User              @relation(fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  payables    Payable[]
  receivables Receivable[]
}

model Payable {
  id                  String             @id @default(cuid())
  number              String
  fornecedor          String
  descricao           String
  categoriaId         String
  categoria           FinancialCategory  @relation(fields: [categoriaId], references: [id])
  centroCusto         String?
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  valor               Float
  dataCompetencia     DateTime
  dataVencimento      DateTime
  dataPagamento       DateTime?
  bankAccountId       String?
  bankAccount         BankAccount?       @relation(fields: [bankAccountId], references: [id])
  formaPagamento      PaymentMethod?
  parcelado           Boolean            @default(false)
  quantidadeParcelas  Int?
  parcelaAtual        Int?
  observacoes         String?
  status              FinanceEntryStatus @default(EM_ABERTO)
  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model Receivable {
  id                  String             @id @default(cuid())
  number              String
  cliente             String
  descricao           String
  categoriaId         String
  categoria           FinancialCategory  @relation(fields: [categoriaId], references: [id])
  centroCusto         String?
  empresaId           String
  empresa             Empresa            @relation(fields: [empresaId], references: [id])
  valor               Float
  dataCompetencia     DateTime
  dataVencimento      DateTime
  dataRecebimento     DateTime?
  bankAccountId       String?
  bankAccount         BankAccount?       @relation(fields: [bankAccountId], references: [id])
  formaRecebimento    PaymentMethod?
  parcelado           Boolean            @default(false)
  quantidadeParcelas  Int?
  parcelaAtual        Int?
  observacoes         String?
  status              FinanceEntryStatus @default(EM_ABERTO)
  recurringTemplateId String?
  recurringTemplate   RecurringTemplate? @relation(fields: [recurringTemplateId], references: [id])
  createdById         String
  createdBy           User               @relation(fields: [createdById], references: [id])
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model CashMovement {
  id            String           @id @default(cuid())
  type          CashMovementType
  bankAccountId String
  bankAccount   BankAccount      @relation("CashMovementAccount", fields: [bankAccountId], references: [id])
  destinoId     String?
  destino       BankAccount?     @relation("CashMovementDestino", fields: [destinoId], references: [id])
  valor         Float
  descricao     String?
  empresaId     String?
  empresa       Empresa?         @relation(fields: [empresaId], references: [id])
  date          DateTime         @default(now())
  createdById   String
  createdBy     User             @relation(fields: [createdById], references: [id])
  createdAt     DateTime         @default(now())
}

// ---------------------------------------------------------------------------
// UNIVERSIDADE GRUPO NORD — treinamentos, trilhas, videoaulas, avaliações,
// certificados, gamificação e biblioteca
// ---------------------------------------------------------------------------

enum CourseStatus {
  RASCUNHO
  PUBLICADO
  ARQUIVADO
}

enum ModuleType {
  VIDEO
  PDF
  CHECKLIST
  LINK
}

enum EnrollmentStatus {
  NAO_INICIADO
  EM_ANDAMENTO
  CONCLUIDO
  REPROVADO
}

enum QuestionType {
  MULTIPLA_ESCOLHA
  VERDADEIRO_FALSO
  DISSERTATIVA
}

model TrainingTrack {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  cargo       String?
  empresaId   String?
  empresa     Empresa? @relation(fields: [empresaId], references: [id])
  description String?
  icon        String   @default("GraduationCap")
  color       String   @default("#2952E3")
  order       Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  courses TrainingTrackCourse[]
}

model TrainingCourse {
  id           String       @id @default(cuid())
  name         String
  slug         String       @unique
  category     String?
  description  String?
  cargo        String?
  empresaId    String?
  empresa      Empresa?     @relation(fields: [empresaId], references: [id])
  imageUrl     String?
  instructor   String?
  cargaHoraria Int          @default(0)
  status       CourseStatus @default(RASCUNHO)
  mandatory    Boolean      @default(false)
  version      Int          @default(1)
  order        Int          @default(0)
  createdById  String
  createdBy    User         @relation(fields: [createdById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  modules              TrainingModule[]
  tracks               TrainingTrackCourse[]
  enrollments          TrainingEnrollment[]
  quiz                 TrainingQuiz?
  trainingCertificates TrainingCertificate[]
}

model TrainingTrackCourse {
  id       String         @id @default(cuid())
  trackId  String
  track    TrainingTrack  @relation(fields: [trackId], references: [id], onDelete: Cascade)
  courseId String
  course   TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  order    Int            @default(0)

  @@unique([trackId, courseId])
}

model TrainingModule {
  id              String         @id @default(cuid())
  courseId        String
  course          TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  type            ModuleType     @default(VIDEO)
  videoUrl        String?
  durationSeconds Int            @default(0)
  pdfUrl          String?
  content         String?
  order           Int            @default(0)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  progress TrainingModuleProgress[]
}

model TrainingEnrollment {
  id              String           @id @default(cuid())
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  courseId        String
  course          TrainingCourse   @relation(fields: [courseId], references: [id])
  status          EnrollmentStatus @default(NAO_INICIADO)
  progressPercent Int              @default(0)
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  moduleProgress TrainingModuleProgress[]
  attempts       TrainingAttempt[]
  certificate    TrainingCertificate?

  @@unique([userId, courseId])
}

model TrainingModuleProgress {
  id             String             @id @default(cuid())
  enrollmentId   String
  enrollment     TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  moduleId       String
  module         TrainingModule     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  watchedSeconds Int                @default(0)
  percentWatched Int                @default(0)
  completed      Boolean            @default(false)
  playCount      Int                @default(0)
  lastDevice     String?
  startedAt      DateTime?
  completedAt    DateTime?
  lastAccessAt   DateTime           @default(now())

  @@unique([enrollmentId, moduleId])
}

model TrainingQuiz {
  id               String         @id @default(cuid())
  courseId         String         @unique
  course           TrainingCourse @relation(fields: [courseId], references: [id], onDelete: Cascade)
  minScore         Int            @default(70)
  maxAttempts      Int            @default(3)
  timeLimitMinutes Int?

  questions TrainingQuestion[]
  attempts  TrainingAttempt[]
}

model TrainingQuestion {
  id     String       @id @default(cuid())
  quizId String
  quiz   TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)
  text   String
  type   QuestionType @default(MULTIPLA_ESCOLHA)
  order  Int          @default(0)

  options TrainingQuestionOption[]
}

model TrainingQuestionOption {
  id         String           @id @default(cuid())
  questionId String
  question   TrainingQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  text       String
  correct    Boolean          @default(false)
  order      Int              @default(0)
}

model TrainingAttempt {
  id            String             @id @default(cuid())
  quizId        String
  quiz          TrainingQuiz       @relation(fields: [quizId], references: [id])
  enrollmentId  String
  enrollment    TrainingEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User               @relation(fields: [userId], references: [id])
  score         Int                @default(0)
  passed        Boolean            @default(false)
  answers       String?
  attemptNumber Int                @default(1)
  startedAt     DateTime           @default(now())
  submittedAt   DateTime?
}

model TrainingCertificate {
  id           String             @id @default(cuid())
  code         String             @unique
  userId       String
  user         User               @relation(fields: [userId], references: [id])
  courseId     String
  course       TrainingCourse     @relation(fields: [courseId], references: [id])
  enrollmentId String             @unique
  enrollment   TrainingEnrollment @relation(fields: [enrollmentId], references: [id])
  cargaHoraria Int                @default(0)
  issuedAt     DateTime           @default(now())
}

model TrainingBadge {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  icon        String   @default("Award")
  color       String   @default("#eab308")
  createdAt   DateTime @default(now())

  users TrainingUserBadge[]
}

model TrainingUserBadge {
  id       String        @id @default(cuid())
  userId   String
  user     User          @relation(fields: [userId], references: [id])
  badgeId  String
  badge    TrainingBadge @relation(fields: [badgeId], references: [id])
  earnedAt DateTime      @default(now())

  @@unique([userId, badgeId])
}

model TrainingXpEvent {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  amount    Int
  reason    String
  createdAt DateTime @default(now())
}

model TrainingLibraryItem {
  id           String   @id @default(cuid())
  name         String
  category     String   @default("Documentos")
  fileUrl      String
  mimeType     String?
  sizeBytes    Int?
  tags         String?
  empresaId    String?
  empresa      Empresa? @relation(fields: [empresaId], references: [id])
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())
}

// ---------------------------------------------------------------------------
// AUDIT
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  empresaId  String?
  empresa    Empresa? @relation(fields: [empresaId], references: [id])
  action     String
  entityType String
  entityId   String?
  before     String?
  after      String?
  createdAt  DateTime @default(now())
}
